# Copier ce fichier en ".env" et renseigner vos valeurs (ne jamais committer le .env réel)

AWS_REGION=eu-west-1
AWS_PROFILE=smartovate-dev

# Identifiants (à privilégier via un profil AWS CLI / rôle IAM plutôt qu'en clair ici)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Modèles Bedrock utilisés (IDs officiels AWS)
BEDROCK_MODEL_CLAUDE=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_TITAN=amazon.nova-lite-v1:0

# Clé API Tavily (recherche web, MHD-18) — gratuite sur https://tavily.com
TAVILY_API_KEY=
